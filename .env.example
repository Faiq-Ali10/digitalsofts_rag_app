# =============================================================================
# Digitalsofts AI Assistant — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=digitalsofts-ai-assistant
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-random-secret-key-min-32-chars

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/digitalsofts
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Auth / JWT ───────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-different-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── LLM Providers ───────────────────────────────────────────────────────────
# Primary: Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here
LLM_PRIMARY_MODEL=gemini/gemini-2.0-flash
LLM_EVAL_MODEL=gemini/gemini-2.0-flash

# Secondary / Fallback: Groq
GROQ_API_KEY=your-groq-api-key-here
LLM_FALLBACK_MODEL=groq/llama-3.1-70b-versatile

# LLM settings
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# ── Embeddings ───────────────────────────────────────────────────────────────
# Local sentence-transformers model
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ── RAG Settings ─────────────────────────────────────────────────────────────
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=20
RAG_RERANK_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.3

# ── Langfuse (Observability) ────────────────────────────────────────────────
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-your-key
LANGFUSE_SECRET_KEY=sk-lf-your-key
LANGFUSE_HOST=http://langfuse:3000

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
